# ── 공개해도 되는 값 (.env 에 넣고 커밋해도 됨) ──────────────────────────
# Google AdSense (비워 두면 광고 자리표시만 보입니다)
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
VITE_AD_SLOT_TOP=
VITE_AD_SLOT_INLINE=
VITE_AD_SLOT_ANCHOR=

# true 로 두면 서버 없이 가상 채널 데이터로 동작합니다 (화면 작업용)
VITE_DEMO_MODE=false

# ── 비밀 값 (.env.local 에만 넣고 절대 커밋하지 마세요) ───────────────────
# YouTube Data API v3 키. 서버 함수(api/)에서만 읽고 브라우저 코드에는 들어가지 않습니다.
# 배포 환경에서는 Vercel → Settings → Environment Variables 에 같은 이름으로 넣으세요.
# YT_API_KEY=
