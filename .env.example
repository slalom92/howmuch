# ── 공개해도 되는 값 (.env 에 넣고 커밋해도 됨) ──────────────────────────
# Google AdSense (비워 두면 광고 자리표시만 보입니다)
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
VITE_AD_SLOT_TOP=
VITE_AD_SLOT_INLINE=
VITE_AD_SLOT_ANCHOR=

# true 로 두면 서버 없이 가상 채널 데이터로 동작합니다 (화면 작업용)
VITE_DEMO_MODE=false

# 카카오톡 공유 (선택). 카카오 디벨로퍼스 JavaScript 키. 공개되는 값이라 .env 에 둬도 됩니다.
# 카카오 디벨로퍼스에서 사이트 도메인을 등록해야 동작합니다. 비우면 링크 복사·기본 공유 창으로 대신합니다.
VITE_KAKAO_JS_KEY=

# ── 비밀 값 (.env.local 에만 넣고 절대 커밋하지 마세요) ───────────────────
# YouTube Data API v3 키. 서버 함수(api/)에서만 읽고 브라우저 코드에는 들어가지 않습니다.
# 배포 환경에서는 Vercel → Settings → Environment Variables 에 같은 이름으로 넣으세요.
# YT_API_KEY=

# OpenDART API 키 (회사 비교 기능). https://opendart.fss.or.kr 에서 무료 발급
# DART_API_KEY=

# KOSIS 연동 (선택). 산업별 평균 임금을 최신 통계로 바꿔 줍니다. 자세한 방법은 README 참고
# KOSIS_API_KEY=
# KOSIS_INDUSTRY_URL=
